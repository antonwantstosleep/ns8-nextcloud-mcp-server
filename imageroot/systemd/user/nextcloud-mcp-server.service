#
# nextcloud-mcp-server. The image ENTRYPOINT listens on 0.0.0.0:8000.
# Override that: this container listens on 127.0.0.1:8001 and is not
# published. nextcloud-mcp-auth-gate.service owns the published port and
# rejects /mcp unless Nextcloud accepts the client's Basic credentials.
# mcp.env is multi_user_basic and must not contain NEXTCLOUD_USERNAME or
# NEXTCLOUD_PASSWORD. secrets.env holds TOKEN_ENCRYPTION_KEY only.
#

[Unit]
Description=Podman nextcloud-mcp-server.service
BindsTo=nextcloud-mcp.service
After=nextcloud-mcp.service nextcloud-mcp-qdrant.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/nextcloud-mcp-server.pid %t/nextcloud-mcp-server.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/nextcloud-mcp-server.pid \
    --cidfile=%t/nextcloud-mcp-server.ctr-id \
    --cgroups=no-conmon \
    --pod-id-file=%t/nextcloud-mcp.pod-id \
    --replace -d --name=mcp \
    --env-file=%S/state/mcp.env \
    --env-file=%S/state/secrets.env \
    --volume mcp-data:/app/data:Z \
    --entrypoint /opt/venv/bin/nextcloud-mcp-server \
    ${NEXTCLOUD_MCP_SERVER_IMAGE} \
    run --host 127.0.0.1 --port 8001
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/nextcloud-mcp-server.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/nextcloud-mcp-server.ctr-id
PIDFile=%t/nextcloud-mcp-server.pid
Type=forking

[Install]
WantedBy=default.target
