import json
import os
import sys

import agent

request = json.load(sys.stdin)
renv = request["environment"]

# configure-module drops any Nextcloud credentials restored with the backup
# and rewrites mcp.env as multi_user_basic.
configure_retval = agent.tasks.run(
    agent_id=os.environ["AGENT_ID"],
    action="configure-module",
    data={
        "host": renv["TRAEFIK_HOST"],
        "http2https": renv.get("TRAEFIK_HTTP2HTTPS", "True") == "True",
        "lets_encrypt": renv.get("LETS_ENCRYPT", "False") == "True",
        "nextcloud_host": renv.get("NEXTCLOUD_HOST", ""),
        "ollama_base_url": renv.get("OLLAMA_BASE_URL", ""),
        "ollama_embedding_model": renv.get("OLLAMA_EMBEDDING_MODEL", "nomic-embed-text"),
        "enable_semantic_search": renv.get("ENABLE_SEMANTIC_SEARCH", "true") == "true",
    },
)
agent.assert_exp(configure_retval["exit_code"] == 0, "The configure-module subtask failed!")
