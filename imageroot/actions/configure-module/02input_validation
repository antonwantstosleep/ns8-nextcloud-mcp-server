import json
import os
import sys
from urllib.parse import urlparse

import agent

agent.set_weight(os.path.basename(__file__), 0)  # Validation step, no task progress at all

data = json.load(sys.stdin)
errors = []


def add_error(parameter, error, value=""):
    errors.append(
        {
            "field": parameter,
            "parameter": parameter,
            "value": value,
            "error": error,
        }
    )


def normalize_http_url(value):
    candidate = str(value or "").strip().rstrip("/")
    parsed = urlparse(candidate)
    if parsed.scheme not in ("http", "https") or not parsed.netloc:
        return None
    if parsed.username or parsed.password:
        return None
    return candidate


nextcloud_host = normalize_http_url(data.get("nextcloud_host", ""))
if not nextcloud_host:
    add_error("nextcloud_host", "invalid_url", data.get("nextcloud_host", ""))

username = str(data.get("nextcloud_username", "")).strip()
if not username or any(ch in username for ch in "\r\n\x00"):
    add_error("nextcloud_username", "invalid_username")

password = data.get("nextcloud_password", "")
if not isinstance(password, str) or password == "" or any(ch in password for ch in "\r\n\x00"):
    # Do not echo the secret back in the validation payload.
    add_error("nextcloud_password", "invalid_password")

semantic = data.get("enable_semantic_search", True)
if not isinstance(semantic, bool):
    add_error("enable_semantic_search", "invalid_boolean", semantic)

ollama_raw = data.get("ollama_base_url", "")
ollama_url = normalize_http_url(ollama_raw) if str(ollama_raw).strip() else ""
if semantic and not ollama_url:
    add_error("ollama_base_url", "invalid_url", ollama_raw)
elif str(ollama_raw).strip() and not ollama_url:
    add_error("ollama_base_url", "invalid_url", ollama_raw)

model = str(data.get("ollama_embedding_model", "")).strip()
if not model or any(ch.isspace() for ch in model):
    add_error("ollama_embedding_model", "invalid_model", model)

if errors:
    agent.set_status("validation-failed")
    json.dump(errors, fp=sys.stdout)
    sys.exit(2)
