import json
import os
import sys
from urllib.parse import urlparse

import agent
import nextcloud_mcp_auth

data = json.load(sys.stdin)

host = data["host"]
http2https = data.get("http2https", True)
lets_encrypt = data.get("lets_encrypt", False)
semantic = data.get("enable_semantic_search", True)


def normalize_http_url(value):
    return str(value or "").strip().rstrip("/")


nextcloud_host = normalize_http_url(data["nextcloud_host"])
ollama_base_url = normalize_http_url(data.get("ollama_base_url", ""))
ollama_model = str(data.get("ollama_embedding_model") or "nomic-embed-text").strip()

# Traefik publishes the pod's localhost MCP port. Clients use https://<host>/mcp.
set_route_data = {
    "instance": os.environ["MODULE_ID"],
    "url": "http://127.0.0.1:" + os.environ["TCP_PORT"],
    "host": host,
    "http2https": http2https,
    "lets_encrypt": lets_encrypt,
    "lets_encrypt_check": True,
    "lets_encrypt_cleanup": True,
}
agent.set_route(set_route_data)

agent.set_env("TRAEFIK_HOST", host)
agent.set_env("TRAEFIK_HTTP2HTTPS", http2https)
agent.set_env("LETS_ENCRYPT", lets_encrypt)
agent.set_env("NEXTCLOUD_HOST", nextcloud_host)
agent.set_env("OLLAMA_BASE_URL", ollama_base_url)
agent.set_env("OLLAMA_EMBEDDING_MODEL", ollama_model)
agent.set_env("ENABLE_SEMANTIC_SEARCH", "true" if semantic else "false")

# Container environment for multi_user_basic. Upstream forbids
# NEXTCLOUD_USERNAME and NEXTCLOUD_PASSWORD in this mode; each client sends
# Authorization: Basic. A Fernet key is added to secrets.env because semantic
# search auto-enables background operations, which require TOKEN_ENCRYPTION_KEY.
mcp_env = {
    "MCP_DEPLOYMENT_MODE": "multi_user_basic",
    "NEXTCLOUD_HOST": nextcloud_host,
    "ENABLE_SEMANTIC_SEARCH": "true" if semantic else "false",
    # Shared pod network namespace: Qdrant is the sidecar on localhost.
    "QDRANT_URL": "http://127.0.0.1:6333",
    "OLLAMA_EMBEDDING_MODEL": ollama_model,
    "TOKEN_STORAGE_DB": "/app/data/tokens.db",
    # Keep fastembed / Hugging Face downloads on the persistent mcp-data volume.
    "HF_HOME": "/app/data/huggingface",
    "XDG_CACHE_HOME": "/app/data/cache",
}
# Persist the URL in module state even when semantic search is off, but do not
# point the container at Ollama unless the feature is enabled.
if semantic and ollama_base_url:
    parsed = urlparse(ollama_base_url)
    mcp_env["OLLAMA_BASE_URL"] = ollama_base_url
    mcp_env["OLLAMA_VERIFY_SSL"] = "true" if parsed.scheme == "https" else "false"

state_dir = os.environ.get("AGENT_STATE_DIR", ".")
mcp_path = os.path.join(state_dir, "mcp.env")
agent.write_envfile(mcp_path, mcp_env)
os.chmod(mcp_path, 0o600)

# Drops any previously stored Nextcloud username/password and ensures the
# Fernet key. Input fields nextcloud_username and nextcloud_password are ignored.
nextcloud_mcp_auth.migrate_to_multi_user_basic(state_dir, create_secrets=True)
