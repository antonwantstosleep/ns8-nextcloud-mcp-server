# Runs before 80restart_service. Existing instances keep single_user_basic
# until this rewrite: mcp.env must not contain NEXTCLOUD_USERNAME, and
# secrets.env must not contain NEXTCLOUD_PASSWORD, or upstream rejects
# MCP_DEPLOYMENT_MODE=multi_user_basic at startup.

import os

import nextcloud_mcp_auth

state_dir = os.environ.get("AGENT_STATE_DIR", ".")
# A configured instance has mcp.env. Ensure secrets.env exists so the unit's
# --env-file and TOKEN_ENCRYPTION_KEY are present before the service restarts.
# An instance that has never been configured is left untouched.
configured = os.path.exists(os.path.join(state_dir, "mcp.env"))
nextcloud_mcp_auth.migrate_to_multi_user_basic(
    state_dir,
    create_secrets=configured,
)
